# Database Configuration (PostgreSQL / H2)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=servicedeskdb
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_URL=jdbc:postgresql://localhost:5432/servicedeskdb

# Backend Server (Spring Boot 3 & Java 21)
PORT=8081
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# SLA Engine Configuration
SLA_CHECK_CRON=0 */1 * * * *
SLA_WARNING_THRESHOLD_PERCENT=75

# Frontend (Angular 18)
FRONTEND_PORT=4201
API_BASE_URL=http://localhost:8081/api/v1
WS_BASE_URL=http://localhost:8081/ws-servicedesk
